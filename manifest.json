{
  "manifest_version": 3,
  "name": "BossPilot",
  "version": "3.0.0",
  "description": "BOSS直聘 AI 实习与校招投递副驾：多关键词宽召回筛选、硬性条件拦截、详情页秒直达投递与防风控拟人沟通。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BossPilot"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.zhipin.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zhipin.com/web/geek/job*",
        "*://*.zhipin.com/job_detail/*"
      ],
      "js": [
        "src/selectors.js",
        "src/job-filters.js",
        "src/content-search.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.zhipin.com/web/geek/chat*"
      ],
      "js": [
        "src/selectors.js",
        "src/job-filters.js",
        "src/content-chat.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
